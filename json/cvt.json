                    {
                      "name": "toUnit"
                    },
                    {
                      "name": "options?"
                    }
                  ]
                }
              ]
            },
            {
              "textRaw": "bytes(source, fromUnit, toUnit, options?)",
              "type": "method",
              "name": "bytes",
              "desc": "<p><strong><code>6.7.0</code></strong></p>\n<ul>\n<li><strong>source</strong> { <a href=\"dataTypes#number\">number</a> | <a href=\"dataTypes#string\">string</a> }</li>\n<li><strong>fromUnit</strong> { <a href=\"dataTypes#string\">string</a> }</li>\n<li><strong>toUnit</strong> { <a href=\"dataTypes#string\">string</a> }</li>\n<li><strong>[ options ]</strong> { <a href=\"dataTypes#object\">object</a> }</li>\n<li><ins><strong>returns</strong></ins> { <a href=\"dataTypes#number\">number</a> | <a href=\"https://docs.oracle.com/javase/8/docs/api/java/math/BigDecimal.html\">java.math.BigDecimal</a> }</li>\n</ul>\n",
              "signatures": [
