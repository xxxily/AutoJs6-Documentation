          "textRaw": "TimedTask",
          "name": "timedtask",
          "desc": "<p><code>TimedTask</code> 是定时任务实体. 源码字段 / 访问器包括 <code>id</code>, <code>millis</code>, <code>timeFlag</code>, <code>scheduled</code>, <code>delay</code>, <code>interval</code>, <code>loopTimes</code>, <code>scriptPath</code>; <code>getNextTime()</code> 返回下一次触发时间对应的毫秒数.</p>\n",
          "type": "module",
          "displayName": "TimedTask"
        },
        {
          "textRaw": "IntentTask",
          "name": "intenttask",
          "desc": "<p><code>IntentTask</code> 是广播任务实体. 源码字段 / 访问器包括 <code>scriptPath</code>, <code>action</code>, <code>category</code>, <code>dataType</code>, <code>local</code>.</p>\n",
          "type": "module",
          "displayName": "IntentTask"
        }
