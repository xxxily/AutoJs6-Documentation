          "textRaw": "[m] of",
          "name": "[m]_of",
          "methods": [
            {
              "textRaw": "of(str, options?)",
              "type": "method",
              "name": "of",
              "desc": "<p><strong><code>6.6.0</code></strong></p>\n<ul>\n<li><strong>str</strong> { <a href=\"dataTypes#string\">string</a> }</li>\n<li><strong>[ options ]</strong> {{<ul>\n<li><strong>separator</strong> / <strong>sep</strong> { <a href=\"dataTypes#string\">string</a> } - 分隔符, 默认空字符串</li>\n<li><strong>case</strong> / <strong>caseType</strong> { <a href=\"dataTypes#string\">string</a> } - <code>LOWERCASE</code> / <code>UPPERCASE</code> 及其别名</li>\n<li><strong>tone</strong> / <strong>toneType</strong> { <a href=\"dataTypes#string\">string</a> } - <code>WITHOUT_TONE</code> / <code>WITH_TONE_NUMBER</code> / <code>WITH_TONE_MARK</code> 及其别名</li>\n<li><strong>v</strong> / <strong>vChar</strong> / <strong>vCharType</strong> { <a href=\"dataTypes#string\">string</a> } - <code>WITH_V</code> / <code>WITH_U_AND_COLON</code> / <code>WITH_U_UNICODE</code> 及其别名</li>\n</ul>\n</li>\n<li>}}</li>\n<li><ins><strong>returns</strong></ins> { <a href=\"dataTypes#string\">string</a> }</li>\n</ul>\n<pre><code class=\"lang-js\">console.log(pinyin4j.of(&#39;中文&#39;)); // zhongwen\nconsole.log(pinyin4j.of(&#39;中文&#39;, { sep: &#39; &#39;, tone: &#39;WITH_TONE_NUMBER&#39; }));\nconsole.log(pinyin4j.of(&#39;中文&#39;, { tone: &#39;WITH_TONE_MARK&#39; }));\n</code></pre>\n",
              "signatures": [
                {
                  "params": [
                    {
                      "name": "str"
                    },
                    {
                      "name": "options?"
                    }
                  ]
                }
              ]
            },
            {
              "textRaw": "of(str, separator)",
