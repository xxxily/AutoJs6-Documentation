                  "params": [
                    {
                      "textRaw": "<ins>**returns**</ins> { [net.lingala.zip4j.ZipFile](https://javadoc.io/doc/net.lingala.zip4j/zip4j/latest/net/lingala/zip4j/ZipFile.html) } ",
