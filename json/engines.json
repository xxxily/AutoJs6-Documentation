                      "name": "eventName"
                    },
                    {
                      "name": "...args"
                    }
                  ]
                }
              ],
              "desc": "<p>向该脚本引擎发送事件. 目标脚本可通过 <code>events</code> 模块监听并在脚本主线程处理.</p>\n<pre><code class=\"lang-js\">/* receiver.js */\nevents.on(&#39;say&#39;, words =&gt; toastLog(words));\nsetInterval(() =&gt; {}, 1000);\n</code></pre>\n<pre><code class=\"lang-js\">let execution = engines.execScriptFile(&#39;./receiver.js&#39;);\nsleep(2000);\nexecution.getEngine().emit(&#39;say&#39;, &#39;hello&#39;);\n</code></pre>\n"
