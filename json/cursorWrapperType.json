        },
        {
          "textRaw": "示例",
          "name": "示例",
          "desc": "<pre><code class=\"lang-js\">let cursor = db.rawQuery(&#39;SELECT id, name FROM user&#39;, []);\nlet rows = cursor.all(); // 默认关闭 cursor.\n\nlet one = db.rawQuery(&#39;SELECT id, name FROM user LIMIT 1&#39;, []).single();\nconsole.log(one &amp;&amp; one.name);\n</code></pre>\n",
          "type": "module",
          "displayName": "示例"
        }
      ],
      "type": "module",
      "displayName": "CursorWrapper"
    }
